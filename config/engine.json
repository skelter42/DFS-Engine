{
  "version": "0.3.0",
  "site": "DraftKings",
  "projection_method": {
    "primary": "market_derived_projection_when_coverage_is_reliable",
    "secondary": "independent_industry_consensus",
    "fallback": "trusted_vendor_projection",
    "fixed_blend_weights": false,
    "require_source_provenance": true
  },
  "candidate_evaluation": {
    "fixed_score_weights": false,
    "factors": [
      "projection",
      "ceiling",
      "leverage",
      "correlation",
      "value",
      "volatility",
      "duplication",
      "contest_fit",
      "thesis_strength"
    ]
  },
  "portfolio": {
    "default_lineups": 20,
    "uniques_policy": "derive_from_slate_contest_and_candidate_quality",
    "exposure_policy": "diagnostic_and_comparative_not_fixed_caps_or_floors",
    "ownership_delta_policy": "investigate_material_deltas_without_fixed_percentage_point_thresholds",
    "multi_contest_allocation": {
      "method": "risk_sensitive_scenario_stratified_quality_ladder",
      "optimize_per_contest_and_global_portfolio": true,
      "require_per_contest_script_coverage": true,
      "allow_modest_priority_quality_tilt": true,
      "reject_leftover_contest_allocation": true
    }
  },
  "required_outputs": [
    "slate_thesis",
    "game_environments",
    "leverage_points",
    "portfolio",
    "correlation_summary",
    "source_ownership_vs_engine_exposure",
    "largest_exposure_deviations",
    "contest_allocation_audit"
  ]
}
