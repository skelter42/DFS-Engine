{
  "version": "0.3.0",
  "site": "DraftKings",
  "market_inputs_projection": {
    "model": "v6_books_drive_savant_fallback",
    "posted_scoring_markets": "de_vig_and_convert_to_site_points",
    "missing_scoring_markets": "preserve_savant",
    "industry": "check_only",
    "preserve_source_zero": true,
    "preserve_ownership": true
  },
  "score_weights": {
    "projection": 1,
    "ceiling": 0.22,
    "leverage": 0.18,
    "correlation": 0.12,
    "value": 0.08,
    "volatility_penalty": 0.05
  },
  "portfolio": {
    "default_lineups": 20,
    "min_uniques": 2,
    "max_player_exposure": 0.65,
    "min_player_exposure": 0,
    "ownership_fade_guardrail_pp": 20,
    "ownership_overweight_guardrail_pp": 30,
    "multi_contest_allocation": {
      "method": "risk_sensitive_scenario_stratified_quality_ladder",
      "optimize_per_contest_and_global_portfolio": true,
      "require_per_contest_script_coverage": true,
      "allow_modest_priority_quality_tilt": true,
      "reject_leftover_contest_allocation": true
    }
  },
  "required_outputs": [
    "slate_thesis",
    "game_environments",
    "leverage_points",
    "portfolio",
    "correlation_summary",
    "source_ownership_vs_engine_exposure",
    "largest_exposure_deviations",
    "contest_allocation_audit"
  ]
}
