{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MLB DFS Engine Slate State",
  "type": "object",
  "required": ["slate_id", "state", "contest_groups", "source_audit", "industry_consensus_board", "scenario_board", "portfolio", "exposure_audit"],
  "properties": {
    "slate_id": {"type": "string"},
    "state": {"enum": ["INTAKE", "INDUSTRY_RESEARCH", "PRELOCK", "FINAL", "POSTSLATE"]},
    "contest_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["contest_type", "entry_count"],
        "properties": {
          "contest_type": {"enum": ["single_entry", "five_max", "twenty_max", "one_fifty_max", "other"]},
          "entry_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "source_audit": {
      "type": "object",
      "required": ["projection_source", "ownership_source", "market_checked", "weather_checked", "lineups_checked", "industry_research_completed"],
      "properties": {
        "projection_source": {"type": "string"},
        "ownership_source": {"type": "string"},
        "market_checked": {"type": "boolean"},
        "weather_checked": {"type": "boolean"},
        "lineups_checked": {"type": "boolean"},
        "industry_research_completed": {"type": "boolean"},
        "research_gaps": {"type": "array", "items": {"type": "string"}}
      }
    },
    "industry_consensus_board": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity", "entity_type", "facts", "ai_interpretation", "confidence"],
        "properties": {
          "entity": {"type": "string"},
          "entity_type": {"enum": ["game", "team", "pitcher", "hitter", "stack"]},
          "facts": {
            "type": "object",
            "properties": {
              "opening_game_total": {"type": ["number", "null"]},
              "current_game_total": {"type": ["number", "null"]},
              "implied_team_runs": {"type": ["number", "null"]},
              "moneyline": {"type": ["number", "null"]},
              "market_movement": {"type": ["string", "null"]},
              "pitcher_k_prop": {"type": ["number", "null"]},
              "park_weather_flag": {"type": ["string", "null"]},
              "lineup_status": {"type": ["string", "null"]},
              "bullpen_note": {"type": ["string", "null"]},
              "role_note": {"type": ["string", "null"]},
              "baseline_projection": {"type": ["number", "null"]},
              "industry_projection_low": {"type": ["number", "null"]},
              "industry_projection_high": {"type": ["number", "null"]},
              "baseline_ownership": {"type": ["number", "null"]},
              "industry_ownership_low": {"type": ["number", "null"]},
              "industry_ownership_high": {"type": ["number", "null"]}
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": {"type": "string"},
                "timestamp": {"type": ["string", "null"]},
                "url_or_reference": {"type": ["string", "null"]}
              }
            }
          },
          "material_disagreement": {"type": ["string", "null"]},
          "ai_interpretation": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "scenario_board": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "family", "confidence", "allocation", "beneficiaries", "field_assumption_that_fails", "supporting_evidence"],
        "properties": {
          "id": {"type": "string"},
          "family": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "allocation": {"type": "number", "minimum": 0, "maximum": 1},
          "beneficiaries": {"type": "array", "items": {"type": "string"}},
          "field_assumption_that_fails": {"type": "string"},
          "supporting_evidence": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        }
      }
    },
    "portfolio": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lineup_id", "contest_type", "scenario_id", "primary_stack", "players", "strategic_reason"],
        "properties": {
          "lineup_id": {"type": "string"},
          "contest_type": {"type": "string"},
          "scenario_id": {"type": "string"},
          "primary_stack": {"type": "string"},
          "secondary_stack": {"type": "string"},
          "pitchers": {"type": "array", "items": {"type": "string"}},
          "players": {"type": "array", "items": {"type": "string"}},
          "salary": {"type": "integer"},
          "projection": {"type": "number"},
          "ceiling": {"type": "number"},
          "lineup_score": {"type": ["number", "null"]},
          "duplication_risk": {"type": "number", "minimum": 0, "maximum": 1},
          "strategic_reason": {"type": "string"},
          "validation_status": {"enum": ["pending", "valid", "invalid"]}
        }
      }
    },
    "exposure_audit": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["player", "source_projected_ownership", "engine_final_exposure", "difference_vs_ownership_pp", "reason"],
        "properties": {
          "player": {"type": "string"},
          "team": {"type": "string"},
          "position": {"type": "string"},
          "source_projected_ownership": {"type": "number"},
          "source_prebuild_exposure": {"type": ["number", "null"]},
          "engine_final_exposure": {"type": "number"},
          "difference_vs_ownership_pp": {"type": "number"},
          "difference_vs_prebuild_pp": {"type": ["number", "null"]},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
